{
  "expo": {
    "name": "결정사",
    "slug": "gyeoljeongsa",
    "scheme": "gyeoljeongsa",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon/app-icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFBF7",
    "primaryColor": "#9B3B52",
    "ios": {
      "bundleIdentifier": "com.gyeoljeongsa.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "사진을 고르려면 사진 접근 권한이 필요해요. 올리려고 고른 사진만 사용해요.",
        "NSCameraUsageDescription": "사진을 직접 찍으려면 카메라 접근 권한이 필요해요. 찍은 사진은 프로필에 올리는 데만 사용해요."
      }
    },
    "android": {
      "package": "com.gyeoljeongsa.app",
      "versionCode": 1,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_CONTACTS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/adaptive-foreground.png",
        "backgroundImage": "./assets/icon/adaptive-background.png",
        "monochromeImage": "./assets/icon/adaptive-monochrome.png",
        "backgroundColor": "#9B3B52"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "lang": "ko",
      "favicon": "./assets/icon/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFBF7",
          "image": "./assets/splash/splash_icon.png",
          "imageWidth": 274,
          "resizeMode": "contain",
          "android": {
            "backgroundColor": "#FFFBF7",
            "drawable": { "icon": "./assets/splash/splash_icon.png" }
          }
        }
      ],
      "expo-secure-store",
      "expo-image",
      [
        "expo-contacts",
        { "contactsPermission": "아는 분과 서로 보이지 않게 하려고 주소록의 번호와 이메일을 기기에서 바꿔 비교해요." }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
