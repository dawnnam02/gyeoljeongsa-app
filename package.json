{
  "name": "gyeoljeongsa-app",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.117.3",
    "expo": "~57.0.28",
    "expo-audio": "~57.0.5",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-contacts": "~57.0.8",
    "expo-crypto": "~57.0.4",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.26",
    "expo-screen-capture": "~57.0.4",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "26.6.5",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:supabase": "node scripts/check-supabase.mjs",
    "check:web": "expo export --platform web",
    "check:smoke": "node scripts/web-smoke.mjs",
    "check:web:demo": "node scripts/export-demo.mjs",
    "check:f1": "node scripts/web-f1.mjs",
    "check:f3": "node scripts/web-f3.mjs",
    "check:f4": "node scripts/web-f4.mjs",
    "check:f2l": "node scripts/web-f2l.mjs",
    "check:f5": "node scripts/web-f5.mjs",
    "check:f6": "node scripts/web-f6.mjs",
    "check:f7": "node scripts/web-f7.mjs",
    "check:f11": "node scripts/web-f11.mjs",
    "check:f13": "node scripts/web-f13.mjs",
    "check:f14": "node scripts/web-f14.mjs",
    "check:f16": "node scripts/web-f16.mjs",
    "check:f17": "node scripts/web-f17.mjs",
    "check:f18": "node scripts/web-f18.mjs",
    "check:f20": "node scripts/web-f20.mjs",
    "gen:schools": "node scripts/gen-schools.mjs",
    "check:bundle-audit": "node scripts/check-bundle-audit.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run check:tokens && npm run check:copy",
    "gen:legal": "node scripts/gen-legal-content.mjs",
    "gen:licenses": "node scripts/gen-licenses.mjs",
    "check:copy": "node scripts/check-copy.mjs && node scripts/check-grade-icon.mjs",
    "check:grade": "node scripts/check-grade-icon.mjs"
  },
  "private": true,
  "description": "결정사 앱 (Expo · TypeScript · Expo Router · Supabase)",
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "testMatch": [
      "<rootDir>/src/**/*.test.ts",
      "<rootDir>/src/**/*.test.tsx"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testTimeout": 30000
  }
}
